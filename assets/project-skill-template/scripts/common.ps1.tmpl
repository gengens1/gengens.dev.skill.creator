# Shared helpers for {{SKILL_NAME}}
$ErrorActionPreference = "Stop"
$script:ProjectSkillName = "{{SKILL_NAME}}"
$script:DocsRootName = "{{DOCS_ROOT}}"
$script:KnownProjects = @({{PROJECT_LIST_PS}})

function Get-ProjectSkillRoot {
  return [System.IO.Path]::GetFullPath((Join-Path $PSScriptRoot ".."))
}

function Get-ProjectRuntimeDir {
  $dir = Join-Path (Get-ProjectSkillRoot) ".runtime"
  if (-not (Test-Path -LiteralPath $dir)) {
    New-Item -ItemType Directory -Force -Path $dir | Out-Null
  }
  return $dir
}

function Resolve-ProjectRepoRoot {
  $dir = [System.IO.Path]::GetFullPath((Join-Path $PSScriptRoot "..\..\..\.."))
  if (Test-Path -LiteralPath (Join-Path $dir ".git")) { return $dir }
  $dir = [System.IO.Path]::GetFullPath($PSScriptRoot)
  for ($i = 0; $i -lt 12; $i++) {
    if (Test-Path -LiteralPath (Join-Path $dir ".git")) { return $dir }
    $parent = Split-Path $dir -Parent
    if (-not $parent -or $parent -eq $dir) { break }
    $dir = $parent
  }
  throw ("PROJECT_DEV_FAIL: cannot find git root from " + $PSScriptRoot)
}

# Runs a native command and captures stdout+stderr without letting stderr become a
# terminating error (PowerShell 5.1 raises NativeCommandError when stderr is redirected
# while $ErrorActionPreference is 'Stop'). Trust the exit code instead.
function Invoke-NativeCaptured([string]$File, [string[]]$Arguments) {
  $eap = $ErrorActionPreference
  $ErrorActionPreference = "Continue"
  $code = -1
  $captured = @()
  try {
    $captured = @(& $File @Arguments 2>&1)
    if ($null -ne $LASTEXITCODE) { $code = $LASTEXITCODE }
  } catch {
    $captured = @($_.Exception.Message)
  } finally {
    $ErrorActionPreference = $eap
  }
  return [pscustomobject]@{ Output = $captured; Code = $code }
}

# Runs a command template, substituting %FILTER% (empty when no filter was given) so
# "run just this test" works without inventing flags for every toolchain.
function Invoke-ProjectCommand {
  param(
    [Parameter(Mandatory = $true)][string]$Template,
    [string]$Name = "",
    [string]$Filter = "",
    [bool]$Explicit = $false
  )
  $text = $Template.Trim()
  if ($Template -match '%FILTER%') {
    $text = $Template.Replace('%FILTER%', $Filter).Trim()
  } elseif (-not [string]::IsNullOrWhiteSpace($Filter)) {
    # Same rule as an unconfigured target: skip under -Project all, complain when named.
    if (-not $Explicit) {
      Write-Host ("PROJECT_SKIP project=" + $Name + " action=filter reason=no-filter-placeholder")
      return
    }
    throw ("PROJECT_VERIFY_FAIL: project '" + $Name + "' has no %FILTER% placeholder in its test command; " +
      "add one (e.g. 'dotnet test %FILTER%') to use -Filter")
  }
  if ([string]::IsNullOrWhiteSpace($text)) {
    throw ("PROJECT_VERIFY_FAIL: empty command for project '" + $Name + "'")
  }
  Write-Host ("PROJECT_RUN " + $text)
  $LASTEXITCODE = 0
  Invoke-Expression $text
  if ($LASTEXITCODE -ne 0) {
    throw ("PROJECT_VERIFY_FAIL: command exited " + $LASTEXITCODE + " : " + $text)
  }
}

# ---- projects -----------------------------------------------------------------------
function Get-ProjectNames {
  return @($script:KnownProjects)
}

function Get-ProjectDir([string]$RepoRoot, [string]$Sub) {
  if ([string]::IsNullOrWhiteSpace($Sub)) { return $RepoRoot }
  return (Join-Path $RepoRoot $Sub)
}

# "all" (or empty) selects every project; a name must exist.
function Select-ProjectTargets([string]$Selection, [string]$ScriptName) {
  $known = @(Get-ProjectNames)
  if ([string]::IsNullOrWhiteSpace($Selection) -or $Selection -eq "all") { return $known }
  if ($known -notcontains $Selection) {
    throw ("PROJECT_FAIL: " + $ScriptName + ": unknown project '" + $Selection + "'; known: " + ($known -join ", "))
  }
  return @($Selection)
}

function Get-ProjectStateFilePath {
  return (Join-Path (Get-ProjectRuntimeDir) "pids.json")
}

function Read-ProjectState {
  $f = Get-ProjectStateFilePath
  if (-not (Test-Path -LiteralPath $f)) { return @{} }
  $raw = [System.IO.File]::ReadAllText($f, [System.Text.Encoding]::UTF8)
  if ([string]::IsNullOrWhiteSpace($raw)) { return @{} }
  try { $obj = $raw | ConvertFrom-Json } catch { return @{} }
  $h = @{}
  if ($obj) { foreach ($p in $obj.PSObject.Properties) { $h[$p.Name] = $p.Value } }
  return $h
}

function Write-ProjectState([hashtable]$State) {
  $enc = New-Object System.Text.UTF8Encoding $false
  [System.IO.File]::WriteAllText((Get-ProjectStateFilePath), ($State | ConvertTo-Json -Depth 6), $enc)
}

function Get-ProjectPidRecord([string]$Name) {
  $state = Read-ProjectState
  if ($state.ContainsKey($Name)) { return $state[$Name] }
  return $null
}

function Remove-ProjectPidRecord([string]$Name) {
  $state = Read-ProjectState
  if ($state.ContainsKey($Name)) {
    $state.Remove($Name)
    Write-ProjectState $state
  }
}

# Launches the project's start block in its own PowerShell process so the caller returns
# immediately, and remembers the PID so stop can kill exactly this tree.
function Start-ProjectBackground {
  param(
    [Parameter(Mandatory = $true)][string]$Name,
    [Parameter(Mandatory = $true)][string]$WorkingDir,
    [Parameter(Mandatory = $true)][scriptblock]$Body,
    [switch]$Foreground
  )
  if (-not (Test-Path -LiteralPath $WorkingDir)) {
    throw ("PROJECT_START_FAIL: project '" + $Name + "' working dir not found: " + $WorkingDir)
  }
  if ($Foreground) {
    Push-Location $WorkingDir
    try { & $Body } finally { Pop-Location }
    return
  }

  $runtime = Get-ProjectRuntimeDir
  $logs = Join-Path $runtime "logs"
  if (-not (Test-Path -LiteralPath $logs)) { New-Item -ItemType Directory -Force -Path $logs | Out-Null }
  $outLog = Join-Path $logs ($Name + ".out.log")
  $errLog = Join-Path $logs ($Name + ".err.log")

  # The start block becomes its own script so it stays readable and editable.
  $bodyPath = Join-Path $runtime ("start-" + $Name + ".ps1")
  $bodyText = ('$ProgressPreference = "SilentlyContinue"' + "`n" +
    'Set-Location -LiteralPath "' + $WorkingDir + '"' + "`n" +
    $Body.ToString() + "`n")
  [System.IO.File]::WriteAllText($bodyPath, $bodyText, (New-Object System.Text.UTF8Encoding $true))

  $exe = Join-Path $env:SystemRoot "System32\WindowsPowerShell\v1.0\powershell.exe"
  if (-not (Test-Path -LiteralPath $exe)) { $exe = (Get-Process -Id $PID).Path }

  # UseShellExecute = $true through cmd.exe is deliberate. A process started with
  # Start-Process inherits this process's stdout handle, so any caller that captures
  # output (an agent tool call, a pipe) would block until the started process exits -
  # i.e. forever for a dev server. ShellExecute does not inherit handles, and cmd
  # provides the log redirection instead.
  $psi = New-Object System.Diagnostics.ProcessStartInfo
  $psi.FileName = "cmd.exe"
  $psi.Arguments = '/c ""' + $exe + '" -NoProfile -ExecutionPolicy Bypass -File "' +
    $bodyPath + '" > "' + $outLog + '" 2> "' + $errLog + '""'
  $psi.UseShellExecute = $true
  $psi.WindowStyle = "Hidden"
  $proc = [System.Diagnostics.Process]::Start($psi)
  Start-Sleep -Milliseconds 300

  $state = Read-ProjectState
  $state[$Name] = @{
    pid        = $proc.Id
    workingDir = $WorkingDir
    log        = $outLog
    errLog     = $errLog
    startedAt  = (Get-Date).ToString("s")
  }
  Write-ProjectState $state
  Write-Host ("PROJECT_STARTED project=" + $Name + " pid=" + $proc.Id + " log=" + $outLog)

  Start-Sleep -Milliseconds 1500
  # ShellExecute-started processes may not expose HasExited, so ask the process table
  $stillRunning = $null -ne (Get-Process -Id $proc.Id -ErrorAction SilentlyContinue)
  if (-not $stillRunning) {
    # one-shot start commands legitimately exit; say so instead of pretending all is well
    Write-Host ("PROJECT_START_WARN project=" + $Name + " exited within 1.5s; log tail:")
    foreach ($f in @($outLog, $errLog)) {
      if (Test-Path -LiteralPath $f) {
        Get-Content -LiteralPath $f -Tail 10 -ErrorAction SilentlyContinue | ForEach-Object { Write-Host ("  " + $_) }
      }
    }
  } else {
    Write-Host ("PROJECT_RUNNING project=" + $Name + " pid=" + $proc.Id)
  }
}

function Stop-ProjectProcess([string]$Name) {
  $rec = Get-ProjectPidRecord $Name
  if (-not $rec) {
    Write-Host ("PROJECT_STOP_SKIP project=" + $Name + " reason=no-start-record")
    return
  }
  $procId = [int]$rec.pid
  $r = Invoke-NativeCaptured "taskkill" @("/T", "/F", "/PID", "$procId")
  if ($r.Code -eq 0) {
    Write-Host ("PROJECT_STOPPED project=" + $Name + " pid=" + $procId)
  } else {
    Write-Host ("PROJECT_STOP_WARN project=" + $Name + " pid=" + $procId + " already gone or not killable")
  }
  Remove-ProjectPidRecord $Name
}
